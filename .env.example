# Copy to .env (never commit .env). All values are optional.

# --- where the dashboard listens on the host (default: localhost only) ---
# Use a LAN/VPN address such as 192.168.x.y or your Tailscale IP. 0.0.0.0 = every interface
# (only do that on a trusted network; the dashboard has no login).
DASH_BIND=127.0.0.1
DASH_PORT=3090
# DASH_CONTAINER_NAME=pi-home-dash

# --- optional container stats (pick one overlay, see docker-compose.yml) ---
# COMPOSE_FILE=docker-compose.yml:compose.docker-proxy.yml
# COMPOSE_FILE=docker-compose.yml:compose.docker-socket.yml
# DOCKER_GID=999

# --- Immich photo carousel (leave IMMICH_URL empty to hide the carousel) ---
# URL the container uses to reach Immich (server-side only):
IMMICH_URL=http://host.docker.internal:2283
# Optional: URL your browser uses for Immich; clicking a photo opens it there.
IMMICH_PUBLIC_URL=
# Create a dedicated API key in Immich (Account settings > API keys) with ONLY these permissions:
#   asset.read, asset.view, album.read
# The key never leaves the server; the browser only gets proxied preview images.
IMMICH_API_KEY=
